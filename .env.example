# RAG Pipeline — example environment configuration.
# Copy to .env and fill in only what you need. The core pipeline runs fully
# offline with the built-in fakes and requires NONE of these.

# --- OpenAI (optional, for real embeddings / generation) ---
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Postgres + pgvector (optional, for a persistent vector store) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/rag
# PGVECTOR_TABLE=rag_chunks

# --- Pipeline tuning (optional) ---
# RAG_TOP_K=4
# RAG_CHUNK_SIZE=50
# RAG_CHUNK_OVERLAP=10
